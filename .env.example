# User API key from https://cursor.com/dashboard/integrations
# or a team service-account key. Required for agent runs.
CURSOR_API_KEY=

# Optional. Defaults to 3847.
PORT=3847

# Bind address. Use 0.0.0.0 in Docker so the port is reachable.
# HOST=0.0.0.0

# Site login. Leave blank to disable authentication.
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_SECRET=
